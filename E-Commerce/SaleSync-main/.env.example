HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# For phone testing on the same private network: HOST=0.0.0.0 and
# APP_ORIGIN=http://YOUR_PC_LAN_IP:3000 (never 0.0.0.0 in an email link).
# Keep http://127.0.0.1:3000 in API_ALLOWED_ORIGINS to continue using it on the PC.
# Optional comma-separated origins for another frontend on the same site.
# Use browser requests with credentials: include and the CSRF token from /api/v1/auth/session.
API_ALLOWED_ORIGINS=
DATABASE_PATH=./data/salesync.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
APP_SECRET=
# Set true only behind HTTPS. Required with NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=development
# Keep false for regular shopping. True exposes seeded records only in isolated development demos.
CATALOG_DEMO=false
# No email is sent until Gmail is configured. No codes are returned in API responses or logged.
MAIL_MODE=gmail
# Gmail or Google Workspace sender address (Google must host the mailbox).
GMAIL_USER=
# Option 1: Google app password (not the normal account password). No spaces needed.
GMAIL_APP_PASSWORD=
# Option 2: Gmail OAuth2. Takes precedence when all three values are provided.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
VERIFICATION_TTL_SECONDS=300
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_MAX_SENDS_PER_HOUR=5
SESSION_TTL_SECONDS=28800
# Development only. No PayMongo account or real money is involved.
# Use paymongo-test only with private test credentials and enabled account methods.
PAYMENT_MODE=local-test
RESERVATION_TTL_SECONDS=900
# Local automatic tracking only; no courier is booked or contacted.
# Use aftership when you have an account, or manual to disable the tracking worker.
COURIER_MODE=local-test
COURIER_TEST_STEP_SECONDS=60
# Server-only credentials. Webhooks require a reachable HTTPS deployment.
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Hosted Checkout TEST ONLY. Never use sk_live credentials. No public key is needed.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated methods enabled in your PayMongo test account; no default is assumed.
PAYMONGO_PAYMENT_METHODS=
# Subscribe checkout_session.payment.paid to your HTTPS tunnel/deployment URL:
# https://YOUR_TEST_HOST/api/v1/webhooks/paymongo
# Set APP_ORIGIN to that reachable origin for Hosted Checkout return URLs.

# Read-only POS backup inventory. Disabled unless a real endpoint/contract is configured.
POS_ENABLED=false
POS_BASE_URL=
# Private bearer token with read-only store/inventory scope; 32+ characters.
POS_AUTH_TOKEN=
# Exact mapping JSON. Use existing e-commerce store IDs and canonical SKUs only.
# [{"storeId":"EXISTING_STORE_ID","posStoreId":"POS_STORE_ID","skus":[{"sku":"EXISTING_SKU","posSku":"POS_SKU"}]}]
POS_MAPPINGS=[]
POS_TIMEOUT_MS=3000
POS_STALE_SECONDS=300
# Development-only localhost HTTP provider; HTTPS is required elsewhere.
POS_ALLOW_HTTP_LOOPBACK=false

# SaleSync POS owns products, categories, prices and stock. This private server-to-server
# connection is used for the catalog, reservations, order completion and cancellations.
ONLINE_POS_ENABLED=false
# Example: http://192.168.1.20/POS%20System/api/storefront/index.php
ONLINE_POS_URL=
# Generate a long random key and place the same value in POS System/api/storefront/config.local.php.
ONLINE_POS_KEY=
ONLINE_POS_TIMEOUT_MS=3000
